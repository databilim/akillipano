# Bu dosyayı .env adıyla kopyalayıp değerleri düzenleyin: cp .env.example .env

PORT=80
# Boş bırakılırsa ilk açılışta rastgele üretilip .oturum-anahtari dosyasına yazılır
SESSION_SECRET=
DB_DOSYA=/home/pi/pano/akillipano.db

# I2C
I2C_BUS=1
ROLE_ADRES=100
BUTON_ADRES=10
BUTON_OKUMA_MS=100
# Röle kartı bu aralıkla yoklanır, art arda I2C_HATA_ESIGI hata olursa ekranda uyarı çıkar
I2C_KONTROL_MS=5000
I2C_HATA_ESIGI=3
# Donanım olmadan bilgisayarda denemek için 1 yapın
I2C_SIMULASYON=0

# Zil rölesinin açık kalma süresi (ms)
ZIL_SURE_MS=3000
# Elektrik gidip gelince açık olan lamba/prizler tekrar açılsın mı (zil her zaman kapalı başlar)
ACILISTA_DURUMU_YUKLE=1

# Zil fotoğrafları
KAYIT_KLASORU=/home/pi/pano/kayitlar
ZIL_KAYIT_GUN=60
# Ana ekrandaki canlı kamera görüntüsü (Pi'yi yormamak için düşük tutun)
KAMERA_GENISLIK=640
KAMERA_FPS=5

# Cloudflare (tunnel ya da proxy) arkasındaysa 1 yapın
CLOUDFLARE=0
